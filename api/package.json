{
  "name": "calory-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "serve.ts",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env serve.ts",
    "start:dev": "nodemon --exec \"tsx --env-file-if-exists=.env\" serve.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:w": "NODE_ENV=test node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "mariadb": "^3.5.5",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
